{
  "name": "deepseek-search-fetch-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Local stdio MCP for the official DeepSeek Search and Fetch APIs",
  "type": "module",
  "bin": {
    "deepseek-search-fetch-mcp": "dist/index.js"
  },
  "files": ["dist", "README.md", ".env.example"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
