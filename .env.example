# Example only. The server reads process environment; it does not auto-load .env.
DEEPSEEK_API_KEY=replace-with-your-official-deepseek-key
DEEPSEEK_MCP_TIMEOUT_MS=30000
DEEPSEEK_MCP_MAX_OUTPUT_CHARS=12000
DEEPSEEK_MCP_CACHE_TTL_MS=600000
DEEPSEEK_MCP_CACHE_MAX_ENTRIES=50
# DEEPSEEK_MCP_PROXY_URL=http://127.0.0.1:7890
DEEPSEEK_MCP_LOG_LEVEL=warn
